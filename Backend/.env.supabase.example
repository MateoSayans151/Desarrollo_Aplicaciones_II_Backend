# Plantilla para Supabase. Copiar las credenciales desde el panel Connect.
# Usar el host exacto que muestra Supabase; no incluir usuario/clave en DB_URL.
# Para una red IPv4-only, preferir Session pooler y copiar host/usuario de Supabase.
DB_URL=jdbc:postgresql://db.TU_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=REEMPLAZAR_POR_LA_PASSWORD_DE_LA_BASE

# No activar el perfil local al usar Supabase.
# SPRING_PROFILES_ACTIVE=local
